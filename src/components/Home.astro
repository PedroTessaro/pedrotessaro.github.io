---
import type { Locale } from "../data/types";
import { useTranslations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Apps from "./Apps.astro";
import Contributions from "./Contributions.astro";
import Sword from "./Sword.astro";
import OtherProjects from "./OtherProjects.astro";
import LiveStatus from "./LiveStatus.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import TabBar from "./TabBar.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale}>
  <a class="skip-link" href="#main">{t("nav.skipToContent")}</a>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Apps locale={locale} />
    <Contributions locale={locale} />
    <Sword locale={locale} />
    <About locale={locale} />
    <OtherProjects locale={locale} />
    <LiveStatus locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <TabBar locale={locale} />
</BaseLayout>

---
import type { Locale } from "../data/types";
import { useTranslations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { fetchLive } from "../data/live";
import { shortName } from "../data/profile";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const live = await fetchLive();
const unavailable = t("status.unavailable");

/** Every row on this page is the same shape, so it's data rather than markup. */
const rows: {
  key: string;
  label: string;
  value: string | number;
  /** Unit the payload doesn't carry; the client refresh re-appends it. */
  suffix?: string;
}[] = [
  { key: "server.region", label: t("status.region"), value: live?.server.region ?? unavailable },
  { key: "server.version", label: t("status.version"), value: live?.server.version ?? unavailable },
  { key: "server.served_in", label: "served in", value: live?.server.served_in ?? unavailable },
  { key: "latency.p50", label: t("status.p50"), value: live?.latency?.p50 ?? unavailable },
  { key: "latency.p95", label: t("status.p95"), value: live?.latency?.p95 ?? unavailable },
  { key: "latency.samples", label: "samples", value: live?.latency?.samples ?? unavailable },
  { key: "ci.status", label: t("status.ci"), value: live?.ci?.status ?? unavailable },
  { key: "ci.tests", label: t("status.tests"), value: live?.ci?.tests ?? unavailable },
  {
    key: "ci.coverage",
    label: t("status.coverage"),
    value: live?.ci ? `${live.ci.coverage}%` : unavailable,
    suffix: "%",
  },
  { key: "ci.sha", label: "ci commit", value: live?.ci?.sha ?? unavailable },
  { key: "github.repos", label: t("status.repos"), value: live?.github.repos ?? unavailable },
  { key: "github.stars", label: t("status.stars"), value: live?.github.stars ?? unavailable },
  { key: "github.commits_this_year", label: t("status.commits"), value: live?.github.commits_this_year ?? unavailable },
  { key: "github.cache_age", label: "cache age", value: live?.github.cache_age ?? unavailable },
  { key: "readme_views.total", label: t("status.views"), value: live?.readme_views?.total ?? unavailable },
  { key: "readme_views.today", label: "views today", value: live?.readme_views?.today ?? unavailable },
];

const endpoints = [
  ["/terminal.svg", "SVG do terminal", "the terminal SVG"],
  ["/whoami", "perfil em JSON", "profile as JSON"],
  ["/repos", "todos os repositórios", "every repository"],
  ["/metrics", "formato Prometheus", "Prometheus format"],
  ["/healthz", "health check", "health check"],
] as const;
---

<BaseLayout
  locale={locale}
  path="status/"
  title={`status — ${shortName}`}
  description="Live status of the service that renders the terminal on my GitHub profile."
>
  <a class="skip-link" href="#main">{t("nav.skipToContent")}</a>
  <Header locale={locale} path="status/" />
  <main id="main">
    <section class="section section-grouped status">
      <div class="container">
        <h1 class="status-title">
          <span class="live-dot" aria-hidden="true"></span>{t("status.title")}
        </h1>
        <p class="section-intro">{t("live.intro")} {t("status.intro")}</p>

        <dl class="group">
          {
            rows.map((row) => (
              <div class="row">
                <dt class="row-title">{row.label}</dt>
                <dd class="row-value" data-live={row.key} data-live-suffix={row.suffix}>
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <h2 class="group-header endpoints-header">{t("status.endpoints")}</h2>
        <ul class="group">
          {
            endpoints.map(([path, pt, en]) => (
              <li class="row-li">
                <a class="row" href={`https://pedrotessaro.vercel.app${path}`}>
                  <code class="row-title">{path}</code>
                  <span class="row-value">{locale === "pt" ? pt : en}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <a class="pill pill-large back" href={`/${locale}/`}>‹ {t("status.back")}</a>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .status {
    min-height: 70vh;
  }
  .status-title {
    margin-bottom: 16px;
    font-size: clamp(30px, 6vw, 40px);
    font-weight: 800;
  }
  .live-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 12px;
    border-radius: 50%;
    background: var(--green);
    vertical-align: middle;
  }
  .row-title {
    flex: 1;
  }
  .row-value {
    font-variant-numeric: tabular-nums;
  }
  code.row-title {
    padding: 0;
    background: none;
    font-size: 15px;
    color: var(--tint);
  }
  .row-li {
    position: relative;
  }
  .row-li + .row-li::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 16px;
    border-top: 0.5px solid var(--separator);
  }
  .endpoints-header {
    margin-top: 32px;
  }
  .back {
    margin-top: 32px;
  }
</style>

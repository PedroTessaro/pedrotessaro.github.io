---
import type { IconName } from "../data/types";

// Ícones de traço no espírito dos SF Symbols, desenhados aqui (os SF Symbols
// não podem ser usados fora de plataformas Apple). Herdam a cor do texto.

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "chevron" && <path d="M9 5l7 7-7 7" />}
  {name === "arrow" && <path d="M7 17L17 7M9 7h8v8" />}
  {
    name === "envelope" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="3" />
        <path d="M4 7l8 6 8-6" />
      </>
    )
  }
  {
    name === "github" && (
      <path d="M9 19c-4 1.3-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.3 5.8 2.6 5.8 2.6a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2v3.5" />
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M8 10.5V16M8 7.5v.01M12 16v-5.5M12 13a2.5 2.5 0 0 1 5 0v3" />
      </>
    )
  }
  {
    name === "doc" && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <path d="M14 3v5h5M9 13h6M9 17h6" />
      </>
    )
  }
  {
    name === "location" && (
      <>
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    name === "graduation" && (
      <>
        <path d="M2 9l10-5 10 5-10 5z" />
        <path d="M6 11v5c3 2.5 9 2.5 12 0v-5M22 9v6" />
      </>
    )
  }
  {
    name === "apple" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="4.5" />
        <path d="M9 12h6M12 9v6" />
      </>
    )
  }
  {
    name === "globe" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
      </>
    )
  }
  {
    name === "music" && (
      <>
        <path d="M9 18V5l11-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="17" cy="16" r="3" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
      </>
    )
  }
  {name === "moon" && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
  {
    name === "app" && (
      <>
        <rect x="3" y="3" width="7.5" height="7.5" rx="2" />
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="2" />
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="2" />
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2" />
      </>
    )
  }
  {
    name === "swift" && (
      <path d="M20 15.5c.8-3.6-1-8-5.6-11 2.3 3 3 6.2 1.9 8.3C12.6 10.4 8.7 7.4 5 4c2.5 3.4 5 6.3 7.4 8.6C9.6 11 6.6 8.8 4 6.5c2.6 5.4 7.1 9.6 12 10.6-2.8 1.5-6.6 1.8-11 .4 3.4 2.7 7.6 3.9 11.2 2.5 1.4-.6 2.6.2 3.8 1.5.3-2.1-.5-4.3 0-6z" />
    )
  }
  {
    name === "terminal" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="3" />
        <path d="M7 9l3 3-3 3M12.5 15H17" />
      </>
    )
  }
  {name === "pulse" && <path d="M3 12h4l2.5-6 5 12 2.5-6h4" />}
  {
    name === "person" && (
      <>
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21c1.5-4 4.4-6 8-6s6.5 2 8 6" />
      </>
    )
  }
  {name === "code" && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16" />}
</svg>

---
import "../styles/global.css";
import type { Locale } from "../data/types";
import { name, role, tagline } from "../data/profile";
import { structuredData } from "../data/structured";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Caminho dentro do idioma, para canonical e hreflang. Vazio na home. */
  path?: string;
}

const { locale, title, description, path = "" } = Astro.props;
const pageTitle = title ?? `${name} — ${role[locale]}`;
const pageDesc = description ?? tagline[locale];
const site = Astro.site ?? new URL("https://pedrotessaro.github.io");
const canonical = new URL(`/${locale}/${path}`, site).href;
const ogImage = new URL(`/og-${locale}.png`, site).href;
---

<!doctype html>
<html lang={locale === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- SF Pro já está no iPhone e no Mac; Inter só entra onde ela não existe. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(`/pt/${path}`, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(`/en/${path}`, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/pt/${path}`, site).href} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData(locale))} />

    <!-- Theme before first paint, so there's no flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          document.documentElement.setAttribute(
            "data-theme",
            stored || (prefersDark ? "dark" : "light")
          );
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Animação de entrada sutil ao rolar -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        var els = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>

    <!--
      The numbers in the HTML were read at build time. This tops them up with
      whatever the service says now, and leaves the built-in values alone if it
      can't reach it. Every target is addressed by data-live, so adding a field
      to the page needs no change here.
    -->
    <script is:inline>
      (function () {
        var targets = document.querySelectorAll("[data-live]");
        if (!targets.length) return;

        fetch("https://pedrotessaro.vercel.app/whoami", {
          signal: AbortSignal.timeout(6000),
        })
          .then(function (res) {
            if (!res.ok) throw new Error(String(res.status));
            return res.json();
          })
          .then(function (data) {
            targets.forEach(function (el) {
              // "github.stars" walks into the payload.
              var value = el.dataset.live.split(".").reduce(function (acc, k) {
                return acc == null ? acc : acc[k];
              }, data);
              if (value !== undefined && value !== null && value !== "") {
                // The build-time render may have added a unit the payload
                // doesn't carry, so the refresh has to add it back.
                el.textContent = String(value) + (el.dataset.liveSuffix || "");
              }
            });
          })
          .catch(function () {
            /* Build-time values stay on screen. */
          });
      })();
    </script>
  </body>
</html>

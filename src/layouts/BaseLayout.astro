---
import "../styles/global.css";
import type { Locale } from "../data/types";
import { name, role } from "../data/profile";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const pageTitle = title ?? `${name} — ${role[locale]}`;
const pageDesc = description ?? role[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary" />

    <!-- Theme before first paint, so there's no flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          document.documentElement.setAttribute(
            "data-theme",
            stored || (prefersDark ? "dark" : "light")
          );
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />

    <!--
      The numbers in the HTML were read at build time. This tops them up with
      whatever the service says now, and leaves the built-in values alone if it
      can't reach it. Every target is addressed by data-live, so adding a field
      to the page needs no change here.
    -->
    <script is:inline>
      (function () {
        var targets = document.querySelectorAll("[data-live]");
        if (!targets.length) return;

        fetch("https://pedrotessaro.vercel.app/whoami", {
          signal: AbortSignal.timeout(6000),
        })
          .then(function (res) {
            if (!res.ok) throw new Error(String(res.status));
            return res.json();
          })
          .then(function (data) {
            targets.forEach(function (el) {
              // "github.stars" walks into the payload.
              var value = el.dataset.live.split(".").reduce(function (acc, k) {
                return acc == null ? acc : acc[k];
              }, data);
              if (value !== undefined && value !== null && value !== "") {
                // The build-time render may have added a unit the payload
                // doesn't carry, so the refresh has to add it back.
                el.textContent = String(value) + (el.dataset.liveSuffix || "");
              }
            });
          })
          .catch(function () {
            /* Build-time values stay on screen. */
          });
      })();
    </script>
  </body>
</html>

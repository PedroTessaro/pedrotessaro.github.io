---
// Raiz: redireciona para o idioma padrão (pt).
// Detecta o idioma do navegador para mandar falantes de inglês para /en/.
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/pt/" />
    <link rel="canonical" href="/pt/" />
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var lang = (navigator.language || "pt").toLowerCase();
        var target = lang.indexOf("en") === 0 ? "/en/" : "/pt/";
        window.location.replace(target);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/pt/">/pt/</a>…</p>
  </body>
</html>
